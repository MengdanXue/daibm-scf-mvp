# DAIBM-SCF deployment configuration. Copy to .env (never commit .env) or run
# scripts/ops/init-env.sh (Linux/macOS) / scripts\ops\init-env.ps1 (Windows),
# which generate random secrets. There are no secret defaults in code.

# --- Required secrets -------------------------------------------------------
POSTGRES_PASSWORD=
# Password of the seeded *.demo accounts. Leave empty in production: no demo
# accounts are created and administrators are provisioned via the admin API.
DAIBM_DEMO_PASSWORD=

# --- Database ---------------------------------------------------------------
# HOST/PORT apply to running the app outside Compose (Compose uses "postgres").
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=daibm_scf
POSTGRES_USER=daibm

# --- Environment and cookies --------------------------------------------------
# production enforces the full password policy on DAIBM_DEMO_PASSWORD.
DAIBM_ENV=demo
# true when served over HTTPS (reverse proxy); the session cookie is then Secure.
DAIBM_COOKIE_SECURE=false
DAIBM_COOKIE_SAMESITE=strict

# --- Login and session policy (defaults; the config center can override) ------
DAIBM_LOGIN_MAX_FAILURES=5
DAIBM_LOCKOUT_MINUTES=15
DAIBM_SESSION_IDLE_MINUTES=30
DAIBM_SESSION_ABSOLUTE_HOURS=12

# --- Operations -----------------------------------------------------------------
# Optional bearer token for scraping /metrics without an admin session.
DAIBM_METRICS_TOKEN=
MVP_PORT=8010
DAIBM_BACKUP_DIR=./backups
RISK_MONITOR_INTERVAL_SECONDS=60

# --- Optional invoice-limit zero-knowledge prover ------------------------------
# Reachable only when the advanced Compose project runs; the workflow degrades to
# recording a fallback code when it is absent in optional mode (false, the default).
# true blocks trade confirmation with HTTP 503 when trusted prover evidence
# is unavailable. This is NOT independent cryptographic verification in Python.
ZKP_PROVER_URL=http://zkp-prover:8091
ZKP_PROOF_REQUIRED=false
