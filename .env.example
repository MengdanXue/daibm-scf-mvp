# Local synthetic-demo defaults. Replace the password outside local demos.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=daibm_scf
POSTGRES_USER=daibm
POSTGRES_PASSWORD=daibm_demo_password

# Optional invoice-limit zero-knowledge prover. Reachable only when the
# advanced Compose project runs; the workflow degrades to recording a
# fallback code when it is absent.
ZKP_PROVER_URL=http://zkp-prover:8091
ZKP_PROOF_REQUIRED=false
